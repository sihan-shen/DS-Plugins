{
  "name": "ds-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "build": "pnpm --filter @ds-plugins/dsh-orchestrator run build",
    "typecheck": "tsc -b",
    "test": "pnpm build && node --expose-internals ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:v0.2a": "pnpm --filter @ds-plugins/dsh-context build && pnpm --filter @ds-plugins/dsh-eval build && pnpm exec vitest run packages/dsh-context/tests packages/dsh-eval/tests tests/eval tests/plugins",
    "test:profile": "vitest run packages/dsh-orchestrator/tests/profile.spec.ts",
    "test:provider": "node --experimental-strip-types tests/provider/openai-codex.smoke.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "tsdown": "0.18.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
