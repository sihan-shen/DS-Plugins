{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./lib",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@ds-plugins/dsh-scheduling-contracts": ["../dsh-scheduling-contracts/src/index.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
