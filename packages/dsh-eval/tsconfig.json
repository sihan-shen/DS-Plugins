{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./lib",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../dsh-context" },
    { "path": "../dsh-code-intelligence" },
    { "path": "../dsh-telemetry" }
  ]
}
