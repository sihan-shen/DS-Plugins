{
  "name": "@ds-plugins/dsh-eval",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./lib/src/index.js",
  "types": "./lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./governance": {
      "types": "./lib/src/governance/index.d.ts",
      "default": "./lib/src/governance/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm run build && pnpm run test:types && cd ../.. && pnpm exec vitest run --config vitest.config.ts packages/dsh-eval/tests",
    "test:types": "tsc --noEmit -p tsconfig.governance-tests.json"
  },
  "dependencies": {
    "@ds-plugins/dsh-code-intelligence": "workspace:*",
    "@ds-plugins/dsh-context": "workspace:*",
    "@ds-plugins/dsh-telemetry": "workspace:*",
    "@dqbd/tiktoken": "1.0.22"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "vitest": "4.0.18"
  },
  "bin": {
    "dsh-telemetry": "./lib/src/telemetry/cli.js"
  }
}
